<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ names.A }} v {{ names.B }}</title>
<style>
:root{--paper:#fff;--ink:#101418;--mut:#5b6470;--rule:#d5d9de;--rule2:#eceef1;--pa:#3a6ea5;--pb:#b3701c;
--flag:#b0413e;--low:#fff2c2;--good:#2f7a4f;--court:#f5f6f8;color-scheme:light;
--cond:"Helvetica Neue",Helvetica,Arial,sans-serif}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.45 "Helvetica Neue",Helvetica,Arial,sans-serif}
.page{max-width:1000px;margin:0 auto;padding:0 16px 40px}
a{color:inherit}
.pa{color:var(--pa)}.pb{color:var(--pb)}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* scoreboard */
.band{background:#fff;color:var(--ink);border-bottom:1px solid var(--rule)}
.band-in{max-width:1000px;margin:0 auto;padding:20px 16px;display:flex;flex-wrap:wrap;gap:14px 40px;align-items:center;justify-content:space-between}
.bug{flex:0 1 460px;min-width:0}
.bug .row{display:flex;align-items:center;gap:10px;padding:5px 0;font-weight:600;font-size:22px;line-height:1.1}
.bug .row+.row{border-top:1px solid var(--rule2)}
.bug .lose{color:var(--mut);font-weight:400}
.bug .chip{width:4px;height:20px;flex:none}
.chipA{background:var(--pa)}.chipB{background:var(--pb)}
.bug .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bug .set{width:30px;text-align:center;font-variant-numeric:tabular-nums}
.bug .set.w{color:var(--ink);font-weight:600}
.bug .set:not(.w){color:#98a1ac;font-weight:400}
.bandr{color:var(--mut);font-size:13px;text-align:right}
.bandr b{display:block;color:var(--ink);font-size:14px;font-weight:600}
@media (max-width:560px){.bandr{text-align:left}.bug .row{font-size:20px}}

/* sections */
section{padding-top:30px}
.page>section+section{border-top:0}
h2{font-weight:600;font-size:21px;line-height:1.2;margin:0 0 4px}
h3{font-size:16px;font-weight:700;margin:18px 0 6px}
.sub{color:var(--mut);font-size:13.5px;margin:0 0 14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px 44px}
.two>*{min-width:0}
@media (max-width:760px){.two{grid-template-columns:1fr}}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px 40px}
.cols>*{min-width:0}
@media (max-width:760px){.cols{grid-template-columns:1fr}}

/* game plan */
.col h3{font-size:17px;font-weight:600;line-height:1.2;margin:6px 0 2px;padding-bottom:6px;border-bottom:2px solid currentColor}
.acts{list-style:none;margin:0;padding:0}
.acts li{padding:10px 0;border-bottom:1px solid var(--rule2)}
.ah{font-size:15.5px;line-height:1.25;font-weight:600;margin:0 0 6px}
.kh{font-size:14px;font-weight:600;margin:14px 0 0}
.kh.st{color:var(--good)}.kh.wk{color:var(--flag)}
.gp{background:var(--court);color:var(--ink);padding:14px 16px;margin-top:16px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.gp h4{font-weight:600;font-size:15.5px;line-height:1.2;margin:0 0 6px}
.gp ol{margin:0;padding:0;list-style:none}
.gp li{padding:8px 0;border-top:1px solid var(--rule)}
.gp li b{display:block;font-size:15.5px;font-weight:600;line-height:1.25}
.gp li span{display:block;font-size:12px;color:var(--mut);margin-top:2px}
.gp .empty{color:var(--mut);padding:0}
.cap{display:block;color:var(--mut);font-size:12px;margin-bottom:3px}
.br{display:grid;grid-template-columns:82px 1fr 104px;gap:8px;align-items:center;font-size:12.5px;line-height:1.5}
.track{display:block;height:9px;background:var(--rule2)}
.track i{display:block;height:100%;background:#5a6673;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.br+.br .track i{background:#bcc3cc}
.bv{white-space:nowrap;color:var(--mut);text-align:right;font-variant-numeric:tabular-nums}
.bv b{color:var(--ink)}
.tag{margin:7px 0 0;font-size:12px;color:var(--mut);display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.dots{display:inline-flex;gap:3px}
.dots i{width:8px;height:8px;border-radius:50%;background:var(--rule);-webkit-print-color-adjust:exact;print-color-adjust:exact}
.d1 i:nth-child(1),.d2 i:nth-child(-n+2),.d3 i{background:#5a6673}
.empty{color:var(--mut);padding:12px 0;margin:0}

/* serve maps */
.who{font-weight:600;font-size:17px;line-height:1.2;margin:16px 0 8px;padding-bottom:6px;border-bottom:2px solid currentColor}
.maps{display:grid;grid-template-columns:1fr 1fr;gap:10px 32px}
@media (max-width:640px){.maps{grid-template-columns:1fr}}
.maps figure{margin:0;min-width:0}
.maps h4{font-size:13.5px;font-weight:600;margin:0 0 5px}
.cA{color:var(--pa)}.cB{color:var(--pb)}
.maps .cA h4,.maps .cB h4{color:var(--ink)}
.sm{display:block;width:100%;height:auto}
.sm .lane{fill:currentColor}
.sm .base{fill:var(--court)}
.sm .sep{stroke:#fff;stroke-width:2}
.sm .box{fill:none;stroke:#8a94a0;stroke-width:1}
.sm .net{stroke:#5a6673;stroke-width:2.5}
.sm text{text-anchor:middle;fill:var(--ink);font-family:"Helvetica Neue",Arial,sans-serif;font-size:10.5px}
.sm .z{font-weight:500;font-size:11px}
.sm .p{font-weight:500;font-size:22px}
.sm .c,.sm .wn{fill:var(--ink);font-size:10px}
.sm .hot .p{font-weight:700}
.sm .side{font-weight:500;font-size:11.5px}
.sm .few{fill:var(--mut)}

/* score situations */
.stk{display:grid;grid-template-columns:96px 1fr 104px;gap:8px;align-items:center;margin:6px 0;font-size:13px}
.seg{display:flex;height:26px;background:var(--rule2)}
.seg i{display:flex;align-items:center;justify-content:center;font-style:normal;font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;background:currentColor;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.seg i span{color:#fff}
.seg i.m{background:color-mix(in srgb,currentColor 62%,#fff)}.seg i.l{background:color-mix(in srgb,currentColor 28%,#fff)}
.seg i.l span{color:var(--ink)}
.seg em{font-style:normal}
@media (max-width:560px){.seg em{display:none}}
.stk .n{color:var(--mut);font-size:12px;text-align:right}
.stk.small .seg{filter:grayscale(1);opacity:.55}
.stk.none .seg{opacity:.5}
a.more-link{font-size:13px;color:var(--mut)}

/* head to head */
.hh{display:grid;grid-template-columns:96px 1fr 160px 1fr 96px;gap:0 10px;align-items:center;font-variant-numeric:tabular-nums}
.hh>div{padding:6px 0;border-bottom:1px solid var(--rule2)}
.hh .names{font-weight:600;font-size:14.5px;border-bottom:1px solid var(--rule)}
.hh .val{font-weight:600;font-size:15px;line-height:1.15}
.hh .val small{display:block;font-weight:400;font-size:11px;color:var(--mut)}
.hh .val.dim{font-weight:400}
.hh .r{text-align:right}
.hh .lab{text-align:center;font-size:13px}
.hb{height:10px;display:flex}
.hb.l{justify-content:flex-end}
.hb i{display:block;height:100%;background:currentColor;opacity:.28;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.hb i.lead{opacity:.8}
@media (max-width:620px){.hh{grid-template-columns:62px 1fr 92px 1fr 62px;gap:0 5px}.hh .lab{font-size:12px}.hh .val{font-size:15px}}
h3.gap{margin-top:24px}
.spl{display:grid;grid-template-columns:96px 34px 1fr 34px 60px;gap:8px;align-items:center;margin:5px 0;font-size:13px;font-variant-numeric:tabular-nums}
.spl .bar{display:flex;height:11px;opacity:.8}
.spl .bar i{display:block;height:100%;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.spl .a{background:var(--pa)}.spl .b{background:var(--pb)}
.spl .r{text-align:right}.spl b{font-size:13.5px;font-weight:600}.spl .n{color:var(--mut);font-size:12px;text-align:right}

/* more detail */
.moreh{margin-top:38px}
details.more{border-top:1px solid var(--rule)}
details.more:last-of-type{border-bottom:1px solid var(--rule)}
details.more>summary{cursor:pointer;font-size:14.5px;font-weight:500;padding:11px 0}
details.more section{padding:0 0 18px}


/* words list */
dl.words dt{font-weight:600;margin-top:.6em}
dl.words dd{margin:.15em 0 0 0}
/* notes and plan */
ol.notes{margin:0;padding:0 0 0 1.4em}
ol.notes li{margin:0 0 10px;padding-left:2px}
.kind{font:700 10.5px/1 -apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;letter-spacing:.08em;
  text-transform:uppercase;margin-right:6px;color:var(--mut)}
.kind.weakness{color:var(--flag)}.kind.strength{color:var(--good)}
.meta{display:block;font-size:12px;color:var(--mut);margin-top:1px}
ul.plan{margin:0;padding:0 0 0 1.4em;list-style:none}
ul.plan li{margin:0 0 10px}
ul.plan li::before{content:"\2192";display:inline-block;width:1.4em;margin-left:-1.4em;color:var(--mut)}
.none{color:var(--mut);font-style:italic}
/* tables */
table.t{width:100%;border-collapse:collapse;font-size:13.5px;font-variant-numeric:tabular-nums}
table.t th,table.t td{padding:5px 8px;text-align:left;vertical-align:baseline;border-bottom:1px solid var(--rule2)}
table.t thead th{font-size:12px;font-weight:600;color:var(--mut);border-bottom:1px solid var(--ink);background:var(--paper)}
table.t td.num,table.t th.num{text-align:right}
table.t td.b{font-weight:700}
table.t small{color:var(--mut);font-size:11.5px}
table.box{max-width:640px}
table.box td:first-child{width:52%}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
/* figures */
figure{margin:0}
figcaption{font-size:12.5px;color:var(--mut);margin-top:4px}
.courts{display:grid;grid-template-columns:1fr 1fr;gap:8px 28px;max-width:760px}
@media (max-width:560px){.courts{grid-template-columns:1fr}}
.courts figure.A{color:var(--pa)}.courts figure.B{color:var(--pb)}
.courts figure h4{font:600 13px/1.3 -apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;color:var(--ink);margin:0 0 4px}
svg{display:block;width:100%;height:auto}
svg text{font-size:10.5px;fill:var(--ink)}
.court .zone{fill:currentColor}
.court .line{fill:none;stroke:var(--ink);stroke-width:1.2}
.court .net{stroke:var(--ink);stroke-width:2.5}
.court .zl,.court .zc,.court .zp,.court .zw,.court .side{text-anchor:middle}
.court .zl{fill:var(--mut);font-size:9.5px}
.court .zc{font-size:14px;font-weight:700}
.court .zp{font-size:10px}
.court .zw{fill:var(--mut);font-size:9.5px}
.court .side{fill:var(--mut);font-size:10px}
.court .bin{fill:var(--ink)}
.court .fx{stroke:var(--flag);stroke-width:1.6}
.chart .axis{stroke:var(--rule);stroke-width:1}
.chart .setline{stroke:var(--rule);stroke-dasharray:3 3}
.chart .gapline{stroke:var(--mut);stroke-width:1.5;stroke-dasharray:1 3}
.chart .marea{fill:currentColor;fill-opacity:.14;stroke:none}
.chart .mline{fill:none;stroke:var(--ink);stroke-width:1.6;stroke-linejoin:round}
.chart .lab{fill:var(--mut);font-size:11px}
.chart .lab.pa{fill:var(--pa)}.chart .lab.pb{fill:var(--pb)}
.chart .bpc{fill:var(--flag)}.chart .bps{fill:var(--paper);stroke:var(--flag);stroke-width:1.6}
.split{display:flex;height:9px;min-width:120px;border:1px solid var(--rule)}
.split i{display:block;height:100%}
.split .a{background:var(--pa)}.split .b{background:var(--pb)}
.key{display:inline-block;width:9px;height:9px;vertical-align:baseline;margin:0 4px 0 12px}
.key.dot{border-radius:50%;background:var(--ink)}
.key.x{background:none;color:var(--flag);width:auto;margin-right:2px;font-weight:700}
.key.ring{border-radius:50%;border:1.6px solid var(--flag)}
.key.fill{border-radius:50%;background:var(--flag)}
/* point by point */
table.pts{font-size:12.5px}
table.pts td{white-space:nowrap}
table.pts tr.gaprow td{color:var(--mut);font-style:italic;text-align:center;padding:4px;border-bottom:1px dashed var(--rule)}
.flag{font:700 10.5px/1 -apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;color:var(--flag);
  letter-spacing:.04em;margin-right:4px}
td.lc{background:var(--low)}
.lcsw{display:inline-block;width:22px;height:11px;background:var(--low);vertical-align:middle;border:1px solid var(--rule)}
.code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.wA{color:var(--pa);font-weight:700}.wB{color:var(--pb);font-weight:700}
.rv{color:var(--mut)}
a.ts{text-decoration:underline;text-decoration-color:var(--rule);text-underline-offset:2px}
a.ts:hover{text-decoration-color:var(--ink)}
.filters{display:flex;flex-wrap:wrap;gap:6px 20px;align-items:center;font-size:13px;margin:4px 0 8px;color:var(--mut)}
select{font-size:13px;background:var(--paper);color:var(--ink);border:1px solid var(--rule);padding:1px 4px}
#player{position:sticky;top:0;z-index:5;display:none;background:var(--paper);border-bottom:1px solid var(--ink);padding:8px 0;margin-top:8px}
#player video{width:100%;max-height:42vh;background:#000}
#player .bar{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--mut);margin-top:4px}
button{font-size:12.5px;background:none;color:var(--ink);border:1px solid var(--rule);padding:2px 10px;cursor:pointer}
tr.warn td:first-child{color:var(--flag)}
/* serve habits */
h4.habsrc{font:600 13px/1.3 -apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;margin:12px 0 4px}
ul.hab{margin:0 0 8px;padding:0 0 0 1.3em;max-width:52em}
ul.hab li{margin:0 0 4px}
details.habd{margin:4px 0 8px}
details.habd summary{cursor:pointer;font-size:13px;color:var(--mut)}
table.hab td{white-space:nowrap}

.note{font-size:13px;color:var(--mut);max-width:52em}
.lede{color:var(--mut);margin:0 0 14px;max-width:46em}
.facts{color:var(--mut);margin:0 0 12px;max-width:46em}
.mfig{display:block}
@media print{
  .page{max-width:none;padding:0}
  .band{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  details.more,.moreh,#player,.filters,button,.noprint{display:none!important}
  section{padding-top:16px;break-inside:avoid-page}
}
</style>
</head>
<body>

<header class="band"><div class="band-in">
  <h1 class="vh">{{ names.A }} v {{ names.B }}</h1>
  <div class="bug">
    {% for P in ['A','B'] %}{% set i = 0 if P=='A' else 1 %}
    <div class="row {{ 'lose' if score.winner and score.winner != P else '' }}"><span class="chip chip{{ P }}"></span><span class="nm">{{ names[P] }}{% if score.winner == P %} <span class="vh">won</span>&#10003;{% endif %}</span>
      {% for s in score.sets %}<span class="set {{ 'w' if s[i] > s[1-i] else '' }}">{{ s[i] }}</span>{% endfor %}
      {% if score.current %}<span class="set">{{ score.current.games[i] }}</span>{% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="bandr"><b>Match report</b>{% if meta.event %}{{ meta.event }}{% if meta.round %}, {{ meta.round }}{% endif %}<br>{% endif %}{% if meta.date %}{{ meta.date }}<br>{% endif %}{{ n_points }} points charted</div>
</div></header>
<div class="page">

<section id="plan">
  <h2>Strengths, weaknesses, game plan</h2>
  <p class="sub">From this one match. Three dots: very unlikely to be luck. One dot: an early sign, so test it before changing anything.</p>
  <div class="two">
  {% for P in ['A','B'] %}{% set C = cards[P] %}
    <div class="col"><h3 class="c{{ P }}">{{ names[P] }}</h3>
    {% for title, cls, items in [('Strengths','st',C.strengths),('Weaknesses','wk',C.weaknesses)] %}
      <h4 class="kh {{ cls }}">{{ title }}</h4>
      {% if items %}<ul class="acts">
      {% for a in items %}<li><p class="ah">{{ a.label }}</p>
        {% for b in a.bars %}<div class="br"><span>{{ b.label }}</span><span class="track"><i style="width:{{ '%.0f'|format(b.pct) }}%"></i></span><span class="bv"><b>{{ b.txt }}</b>{% if b.of %} {{ b.of }}{% endif %}</span></div>{% endfor %}
        <p class="tag"><span class="dots d{{ a.dots }}"><i></i><i></i><i></i></span>{{ a.level }}, {{ a.cap|lower }}{% for n in a.notes %}, {{ n }}{% endfor %}</p></li>{% endfor %}
      </ul>{% else %}<p class="empty">Nothing clear from this match.</p>{% endif %}
    {% endfor %}
      <div class="gp"><h4>How to play against {{ names[P] }}</h4>
      {% if C.plan %}<ol>{% for a in C.plan %}<li><b>{{ a.plan }}</b><span>{{ a.level }}. {{ a.stat }}</span></li>{% endfor %}</ol>
      {% else %}<p class="empty">Nothing clear enough from this match.</p>{% endif %}</div>
    </div>
  {% endfor %}
  </div>
</section>

<section id="map">
  <h2>Where they serve</h2>
  <p class="sub">Seen from behind the server, net at the bottom. Darker means more serves. "Won" is points the server won after that serve.</p>
  {% for P in ['A','B'] %}
  <div class="c{{ P }}"><p class="who">{{ names[P] }}</p>
  <div class="maps">
    {% for sn in ['1','2'] %}<figure class="c{{ P }}"><h4>{{ '1st' if sn=='1' else '2nd' }} serve</h4>{{ maps[P][sn]|safe_svg }}</figure>{% endfor %}
  </div></div>
  {% endfor %}
</section>

<section id="big">
  <h2>Does it change with the score?</h2>
  <p class="sub">Where serves landed, first and second serves together. Left to right: T, body, wide. <a class="more-link" href="#habits">See every score</a></p>
  <div class="two">
  {% for P in ['A','B'] %}
    <div class="c{{ P }}"><p class="who">{{ names[P] }}</p>
    {% for r in big[P].rows %}
      <div class="stk {{ 'small' if r.too_small else '' }}"><span style="color:var(--ink)">{{ r.label }}</span>
        <span class="seg">{% if r.seen %}{% for z, cls in [('T',''),('body','m'),('wide','l')] %}{% if r.pct[z] %}<i class="{{ cls }}" style="width:{{ '%.1f'|format(r.pct[z]) }}%"><span>{% if r.pct[z] >= 12 %}{% if r.pct[z] >= 30 %}<em class="zn">{{ 'Body' if z=='body' else ('Wide' if z=='wide' else 'T') }} </em>{% endif %}{{ '%.0f'|format(r.pct[z]) }}%{% endif %}</span></i>{% endif %}{% endfor %}{% endif %}</span>
        <span class="n">{% if not r.seen %}none seen{% elif r.too_small %}only {{ r.seen }}, too few{% else %}{{ r.seen }} serves{% endif %}</span></div>
    {% endfor %}
    {% if big[P].computer_only %}<p class="sub" style="margin-top:6px">Computer only, not checked.</p>{% endif %}
    </div>
  {% endfor %}
  </div>
</section>

<section id="h2h">
  <h2>Head to head</h2>
  <div class="hh" style="margin-top:10px">
    <div class="names pa">{{ names.A }}</div><div class="names"></div><div class="names"></div><div class="names"></div><div class="names pb r">{{ names.B }}</div>
    {% for r in h2h %}
    <div class="val {{ '' if r.lead=='A' else 'dim' }}">{{ r.a }}{% if r.a_of %}<small>{{ r.a_of }}</small>{% endif %}</div>
    <div class="pa"><div class="hb l"><i class="{{ 'lead' if r.lead=='A' else '' }}" style="width:{{ '%.0f'|format(r.a_w) }}%"></i></div></div>
    <div class="lab">{{ r.label }}</div>
    <div class="pb"><div class="hb"><i class="{{ 'lead' if r.lead=='B' else '' }}" style="width:{{ '%.0f'|format(r.b_w) }}%"></i></div></div>
    <div class="val r {{ '' if r.lead=='B' else 'dim' }}">{{ r.b }}{% if r.b_of %}<small>{{ r.b_of }}</small>{% endif %}</div>
    {% endfor %}
  </div>
  <h3 class="gap">Points won by rally length</h3>
  {% for r in rally_rows %}{% if r.n %}
  <div class="spl"><span>{{ r.label }} shots</span><b class="pa r">{{ r.A }}</b><span class="bar"><i class="a" style="width:{{ '%.1f'|format(r.pct_a) }}%"></i><i class="b" style="width:{{ '%.1f'|format(100 - r.pct_a) }}%"></i></span><b class="pb">{{ r.B }}</b><span class="n">{{ r.n }} points</span></div>
  {% endif %}{% endfor %}
</section>

<section id="flow">
  <h2>How the match went</h2>
  <p class="sub">Above the line, {{ names.A }} has won more points. Below it, {{ names.B }}.</p>
  <figure style="margin:0">
    {{ momentum_svg|safe_svg }}
    <figcaption>Dots mark break, set and match points:<span class="key fill"></span>won<span class="key ring"></span>saved. A dotted line marks a place where points may be missing (the video was cut there, or the score jumped in a way the computer could not follow).</figcaption>
  </figure>
</section>

<h2 class="moreh">More detail</h2>

<details class="more"><summary>Every note, and how sure each one is</summary>
<section id="notes">

  {% if not (insights.A or insights.B or recs.A or recs.B) %}
  <p class="lede">Nothing to report yet. A pattern needs at least 5 points behind it and a gap of 15 percentage points; {{ n_points }} points is too few. A full match usually gives plenty.</p>
  {% else %}
  <p class="lede">Patterns with at least 5 points behind them and a gap of 15 percentage points or more (a percentage point is one point on the 0 to 100 percent scale, so 80% against 65% is a gap of 15). For where serves landed, the gap is between the most common spot and the next most common one, so a near even split is not called a habit. Where a serve landed is compared first serve against first serve and second serve against second serve, because second serves win fewer points wherever they land. The three spots in the service box are <b>T</b> (near the middle line), <b>body</b> (the middle third, where the receiver usually stands) and <b>wide</b> (near the side line). On the <b>deuce side</b> the server stands on the right half of the court, seen from the server; on the <b>ad side</b>, on the left half.</p>
  <p class="note"><b>How sure a note is.</b> Even with no real difference, chance alone makes some gaps in one match. For each note the program works out how often chance would give a gap at least this big (a Fisher exact test, or a binomial test for a split between two spots). <b>High confidence</b>: less than 1 time in 100. <b>Medium</b>: less than 1 time in 20. <b>Low</b>: more often than that, or fewer than 10 points (a small sample), or the computer was unsure of the values; read low notes as things to watch for, not conclusions. Many notes are tested at once, so now and then even a medium note is only chance. "Checked in a review" means the values behind a note were checked, not that the pattern or the plan was tested. The plan is only made from high and medium notes, and it is a set of ideas from this one match, not proven advice.</p>
  <div class="cols">
  {% for P in ['A','B'] %}
    <div>
      <h3 class="{{ 'pa' if P=='A' else 'pb' }}">{{ names[P] }}</h3>
      {% if insights[P] %}
      <ol class="notes">
        {% for i in insights[P] %}
        <li><span class="kind {{ i.kind }}">{{ i.kind }}</span>{{ i.text }}
          <span class="meta">{{ i.confidence }} confidence{% if i.chance_p is not none %} (chance gives a gap this big {{ chance_words(i.chance_p) }}){% endif %}{% if i.small_sample %}, small sample{% endif %}{% set ck = i.checked or {} %}{% if ck.status == 'all' %}, values checked in a review{% elif ck.status == 'some' %}, values partly checked in a review ({{ ck.k }} of {{ ck.n }} points){% else %}, computer only, not checked{% endif %}{% if i.low_confidence %}, low tracking confidence{% endif %}</span></li>
        {% endfor %}
      </ol>
      {% else %}<p class="none">Nothing stands out yet. More points are needed.</p>{% endif %}
      <h3>Plan for {{ names[P] }}</h3>
      {% if recs[P] %}
      <ul class="plan">
        {% for r in recs[P] %}<li>{{ r.text }}<span class="meta">Idea from this note ({{ r.confidence }} confidence): {{ r.basis }}{% set ck = r.checked or {} %}{% if ck.status == 'all' %} The values behind it were checked in a review; the idea itself is not tested.{% elif ck.status == 'some' %} The values behind it were partly checked in a review; the idea itself is not tested.{% else %} Computer only, not checked.{% endif %}</span></li>{% endfor %}
      </ul>
      {% else %}<p class="none">No note is strong enough for a plan: none has a gap that chance would give less than 1 time in 20.</p>{% endif %}
    </div>
  {% endfor %}
  </div>
  {% endif %}
</section>
</details>

<details class="more"><summary>All match statistics</summary>
<section id="stats">

  <div class="scroll"><table class="t box">
    <thead><tr><th></th><th class="num pa">{{ names.A }}</th><th class="num pb">{{ names.B }}</th><th>Checked in a review</th></tr></thead>
    <tbody>
    {% for r in key_rows %}
    <tr><td>{{ r.label }}</td><td class="num {{ 'b' if r.hl=='A' else '' }}">{{ r.a|safe }}</td><td class="num {{ 'b' if r.hl=='B' else '' }}">{{ r.b|safe }}</td><td>{{ r.checked }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="note">Percentages only count points where the needed value was found; the count is in brackets. The better figure is in bold. The last column says whether the values a row is built from were checked in a review: "no, computer only" rows were made by the computer alone and were not checked, so treat them as rough.</p>
</section>
</details>

<details class="more"><summary>Every serve landing spot</summary>
<section id="serve">

  <p class="lede">Each court is drawn from behind the server, net at the bottom. In each zone: serves landed there, share of serves to that side, and points the server won.</p>
  {% for P in ['A','B'] %}
  <h3 class="{{ 'pa' if P=='A' else 'pb' }}">{{ names[P] }} serving</h3>
  <div class="courts">
    {% for sn in ['1','2'] %}
    <figure class="{{ P }}">
      <h4>{{ '1st' if sn=='1' else '2nd' }} serve</h4>
      {{ serve[P][sn].svg|safe_svg }}
      <figcaption>{{ serve[P][sn].caption }}</figcaption>
    </figure>
    {% endfor %}
  </div>
  {% endfor %}
  <p class="note">Marks show tracked bounces:<span class="key dot"></span>in<span class="key x">×</span>fault. "39 known" under a side counts the serves that went in there with a known landing spot; the caption gives how many went in on each side in all.</p>
</section>
</details>

<details class="more"><summary>Serve numbers by score</summary>
<section id="habits">

  <p class="lede">Where each player's serves landed, split by the side of the court, first or second serve, and the score. Every share shows its count, for example "7 of 11 (64%)". A row with fewer than {{ habits.small }} serves seen is marked "too small": too few serves to call it a habit. Values checked in a review and values found by the computer alone are counted apart and never mixed.</p>
  <p class="note"><b>T</b>: the serve landed near the middle line. <b>Body</b>: the middle third of the service box, where the receiver usually stands. <b>Wide</b>: near the side line. <b>Unknown</b>: the serve went in, but where it landed was not found. Only serves that went in have a direction. For values found by the computer alone, when the bounce was not seen, T or wide can be a guess from where the receiver stood to return the serve.
    <b>Deuce side</b>: the server stands on the right half of the court, seen from the server; the first point of every game is played from here. <b>Ad side</b>: the left half.
    A <b>fault</b> is a serve that misses; after a first serve fault comes a second serve, and two faults in a row are a <b>double fault</b>, which loses the point.
    Scores are written server first, so 40-0 means the server leads. <b>Break point</b>: the receiver wins the game by winning this point. <b>Game point</b>: the server wins the game by winning this point. <b>Deuce</b> is 40-40, and <b>advantage</b> is the point after it. Tiebreak points have their own row and are not in the other situations.
    The situations overlap: 0-40, 15-40, 30-40 and advantage receiver are also break points, and 40-0, 40-15, 40-30 and advantage server are also game points, so the same serve can be in more than one row. Do not add rows together.</p>
  {% if meta.review and meta.review.source %}<p class="note">Where the checked values come from: {{ meta.review.source }}.</p>{% endif %}
  {% for P in ['A','B'] %}{% set H = habits.players[P] %}
  <h3 class="{{ 'pa' if P=='A' else 'pb' }}">{{ names[P] }} serving</h3>
  <p class="note">{{ H.note }}</p>
  {% if not H.sources %}<p class="none">No serves found yet.</p>{% endif %}
  {% for S in H.sources %}
  <h4 class="habsrc">{{ S.title }}</h4>
  <ul class="hab">
    {% for l in S.lines %}<li>{{ l }}</li>
    {% endfor %}
  </ul>
  {% for tb in S.tables %}
  <details class="habd"><summary>{{ tb.title }} by score situation, {{ S.title|lower }}</summary>
  <div class="scroll"><table class="t hab">
    <thead><tr><th>Situation</th><th>Side</th><th class="num">Points</th><th class="num">Seen</th><th class="num">T</th><th class="num">Body</th><th class="num">Wide</th><th class="num">Went in, spot unknown</th><th class="num">In or out unknown</th><th>Note</th></tr></thead>
    <tbody>
    {% for r in tb.rows %}<tr class="{{ 'small' if r.too_small else '' }}"><td>{{ r.situation }}</td><td>{{ r.side }}</td><td class="num">{{ r.points }}</td><td class="num">{{ r.seen }}</td><td class="num">{{ r['T'] }}</td><td class="num">{{ r['body'] }}</td><td class="num">{{ r['wide'] }}</td><td class="num">{{ r.dir_unknown }}</td><td class="num">{{ r.res_unknown }}</td><td>{% if r.too_small %}too small{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  </details>
  {% endfor %}
  {% endfor %}
  {% endfor %}
  <p class="note">"Seen" counts serves that went in with a known landing spot; T, body and wide are shares of that number. "Points" is how many points were served in that situation from that side; "Seen" is lower when serves missed, were not found, or landed where nobody could tell. A serve counts as checked only when every value used from it was set or confirmed in a review. One match is a small sample: even a row with enough serves shows what happened in this match, not a proven habit.</p>
</section>
</details>

<details class="more"><summary>How points ended</summary>
<section id="endings">

  <div class="cols">
    <div>
      <h3>By wing</h3>
      <div class="scroll"><table class="t">
        <thead><tr><th></th><th class="num pa" colspan="2">{{ names.A }}</th><th class="num pb" colspan="2">{{ names.B }}</th></tr>
          <tr><th></th><th class="num">FH</th><th class="num">BH</th><th class="num">FH</th><th class="num">BH</th></tr></thead>
        <tbody>
        {% for r in wing_rows %}
        <tr><td>{{ r.label }}</td><td class="num">{{ r.A[0] }}</td><td class="num">{{ r.A[1] }}</td><td class="num">{{ r.B[0] }}</td><td class="num">{{ r.B[1] }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
      <p class="note">Only points where the wing of the last shot was seen.</p>
    </div>
    <div>
      <h3>By rally length</h3>
      <div class="scroll"><table class="t">
        <thead><tr><th>Shots</th><th class="num pa">{{ names.A }}</th><th class="num pb">{{ names.B }}</th><th></th></tr></thead>
        <tbody>
        {% for r in rally_rows %}
        <tr><td>{{ r.label }}</td><td class="num">{{ r.A }}</td><td class="num">{{ r.B }}</td>
          <td>{% if r.n %}<span class="split" title="{{ names.A }} won {{ r.A }} of {{ r.n }}"><i class="a" style="width:{{ '%.0f'|format(r.pct_a) }}%"></i><i class="b" style="width:{{ '%.0f'|format(100 - r.pct_a) }}%"></i></span>{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
      <p class="note">Points won, counting the serve as shot one. Double faults left out.</p>
    </div>
  </div>
</section>
</details>

<details class="more"><summary>Point by point</summary>
<section id="points">
<div id="player" class="noprint">
  <video id="vid" controls preload="none" playsinline></video>
  <div class="bar"><span id="vlabel"></span><button onclick="closePlayer()">Close</button></div>
</div>
  <div class="filters noprint">
    <label><input type="checkbox" id="fPress"> break, set and match points</label>
    <label><input type="checkbox" id="fLow"> needs checking</label>
    <label>Server <select id="fSrv"><option value="">both</option><option value="A">{{ names.A }}</option><option value="B">{{ names.B }}</option></select></label>
  </div>
  <div class="scroll"><table class="t pts" id="ptab">
    <thead><tr><th>#</th><th>Set</th><th>Games</th><th>Points</th><th>Server</th><th>Side</th><th></th>
      <th>1st serve</th><th>2nd serve</th><th>Return</th><th class="num">Shots</th><th>Ending</th><th>Won</th><th>Code</th><th>Video</th></tr></thead>
    <tbody>
    {% for r in rows %}
      {% if r.gap %}<tr class="gaprow" data-gap="1"><td colspan="15">points may be missing here (the video was cut, or the score jumped in a way the computer could not follow)</td></tr>{% endif %}
      {% if r.fill_start %}<tr class="gaprow" data-gap="1"><td colspan="15">the score board skipped the next {{ r.fill_run }} point{{ 's' if r.fill_run != 1 else '' }}; {{ 'they are' if r.fill_run != 1 else 'it is' }} in the video, and who won was worked out from the score</td></tr>{% endif %}
      <tr data-srv="{{ r.server }}" data-press="{{ 1 if r.tags else 0 }}" data-low="{{ 1 if (r.low.winner or r.low.serves or r.low.ret or r.low.rally or r.low.ending) else 0 }}">
        <td>{{ r.id }}{% if r.reviewed %} <span class="rv" title="every value checked in a review">✓</span>{% elif r.added %} <span class="rv" title="added in a review: the computer missed this point">+</span>{% elif r.edited %} <span class="rv" title="edited in a review">✎</span>{% endif %}{% if r.checked and not r.reviewed %} <span class="rv" title="some values checked in a review">c</span>{% endif %}</td>
        <td>{{ r.set_no }}</td><td>{{ r.games }}</td><td>{{ r.points }}{% if r.in_tb %} <small>tb</small>{% endif %}</td>
        <td class="{{ 'wA' if r.server=='A' else 'wB' }}">{{ names[r.server] if r.server in names else r.server }}</td><td>{{ r.side }}</td>
        <td>{% for t in r.tags %}<span class="flag">{{ t }}</span>{% endfor %}</td>
        <td class="{{ 'lc' if r.low.serves else '' }}">{{ r.s1 }}</td><td class="{{ 'lc' if r.low.serves else '' }}">{{ r.s2 }}</td>
        <td class="{{ 'lc' if r.low.ret else '' }}">{{ r.ret }}</td><td class="num {{ 'lc' if r.low.rally else '' }}">{{ r.rally }}</td>
        <td class="{{ 'lc' if r.low.ending else '' }}">{{ r.ending }}</td>
        <td class="{{ 'lc' if r.low.winner else '' }} {{ 'wA' if r.winner=='A' else ('wB' if r.winner=='B' else '') }}" title="source: {{ r.winner_src }}">{{ names[r.winner] if r.winner in names else r.winner }}</td>
        <td class="code">{{ r.mcp }}</td>
        <td>{% if r.href %}<a class="ts" href="{{ r.href }}" data-t="{{ '%.1f'|format(r.t) }}">{{ r.t_label }}</a>{% else %}{{ r.t_label }}{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="note"><span class="lcsw"></span> confidence under {{ low_conf }} and not checked in a review. ✓ every value checked, ✎ edited, + added (missed by the computer), c some values checked in a review. Scores are before the point, {{ names.A }} first; tb means a tiebreak point. BP break point (the receiver wins the game by winning it), SP set point, MP match point. Video gives the time of the point's first serve when it is known, otherwise the start of the stretch of video the point was found in; clicking it starts the video 3 seconds earlier.
    Code follows the Match Charting Project: serve 4 wide, 5 body, 6 T; f/b forehand/backhand, v volley, q shot not identified; * winner, @ unforced error, # forced error; n net, w wide, d deep.</p>
</section>
</details>

<details class="more"><summary>About the data</summary>
<section id="quality">
{% set hand_word = {'R': 'right-handed', 'L': 'left-handed'} %}
<p class="facts">{{ format_desc }}.{% for P in ['A','B'] %}{% if hands[P] %}{% if hands_given[P] %} {{ names[P] }} {{ hand_word.get(hands[P], hands[P]) }} (entered when the video was analyzed).{% else %} {{ names[P] }}'s playing hand was not entered, so the program takes this player as {{ hand_word.get(hands[P], hands[P]) }} (its default, not checked); the forehand and backhand counts for this player depend on it.{% endif %}{% endif %}{% endfor %}
  {{ n_points }} points charted from {{ video_name }}{% if duration %} ({{ duration }}){% endif %};
  {% if meta.has_scorebug %}the score is read from the broadcast's score board.{% else %}no score board was found, so the score is replayed from the point winners the computer guessed.{% endif %}</p>
  <div class="scroll"><table class="t">
    <thead><tr><th>Field</th><th class="num">Detected</th><th class="num">Coverage</th><th class="num">Mean confidence</th><th class="num">Needs checking</th></tr></thead>
    <tbody>
    {% for q in quality %}
    <tr class="{{ 'warn' if q.warn else '' }}"><td>{{ q.field }}</td><td class="num">{{ q.known }}/{{ q.total }}</td>
      <td class="num">{{ ('%.0f'|format(q.pct)) ~ '%' if q.pct is not none else '-' }}</td>
      <td class="num">{{ '%.2f'|format(q.mean_conf) if q.mean_conf is not none else '-' }}</td><td class="num">{{ q.low }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="note">
    Who won each point, by where it came from: {% for k, v in winner_sources.items() %}{{ k }}: {{ v }}{% if not loop.last %}; {% endif %}{% endfor %}.
    Places where points may be missing (the video was cut, or the score jumped in a way the computer could not follow): {{ stats.n_gaps }}.{% if stats.n_filled %} Points the score board skipped, with the winner worked out from the score: {{ stats.n_filled }}.{% endif %}
    Points with every value checked in a review: {{ stats.n_reviewed }}; with an edited value: {{ stats.n_edited }}{% if stats.n_checked %}; with some values checked in a review: {{ stats.n_checked }}{% endif %}{% if stats.n_added %}; added in a review: {{ stats.n_added }}{% endif %}.
    {% if meta.review and meta.review.source %}Where the review values come from: {{ meta.review.source }}{% endif %}
    {% if meta.scorebug_warning %}<b>Score board warning:</b> {{ meta.scorebug_warning }}{% endif %}
    Fields marked in red were detected on fewer than half the points or with low confidence, so treat numbers built on them as rough.
    Forced versus unforced error is the hardest call for the computer (and often for people); confirm it in the review tool.
  </p>
</section>
</details>

<details class="more"><summary>Words used in this report</summary>
<section id="words">

  <dl class="words">
    <dt>Point, game, set</dt><dd>A point is one rally. Four points (with a lead of two) win a game, six games (with a lead of two) win a set, and the match goes to the player who wins most of the sets.</dd>
    <dt>Advantage, no-ad, tiebreak</dt><dd>With advantage scoring, a game at 40-40 (deuce) goes on until one player wins two points in a row. With no-ad scoring the point at 40-40 decides the game. A tiebreak is the special game played at 6-6 to decide a set.</dd>
    <dt>Serve, fault, double fault, ace</dt><dd>Each point starts with a serve, which must land in the service box: the box on the other side between the net and the service line, diagonally across. A serve that misses is a fault; the server then gets a second serve, and two faults in a row (a double fault) lose the point. An ace is a serve that lands in and that the receiver does not touch.</dd>
    <dt>Return, return in play, return error</dt><dd>The return is the receiver's first shot, hitting the serve back. Return in play: the return landed in. Return error: the return missed.</dd>
    <dt>Rally, shots</dt><dd>The shots of one point, counting the serve as shot one.</dd>
    <dt>Forehand (FH), backhand (BH), wing</dt><dd>A forehand is hit on the side of the hand that holds the racket, a backhand on the other side. Wing means forehand or backhand.</dd>
    <dt>Winner, unforced error, forced error</dt><dd>A winner lands in and the other player cannot reach it. An unforced error is a miss on a ball the player had time to play well. A forced error is a miss caused by a hard shot from the other player.</dd>
    <dt>Break point, break points saved and converted</dt><dd>A break point is a point where the receiver wins the server's game by winning it. Converted: the receiver won it. Saved: the server won it.</dd>
    <dt>Net points won</dt><dd>Points where the player came forward close to the net, and the share of them the player won.</dd>
    <dt>Distance run per point</dt><dd>How far the player moved during a point, in metres, measured from the video.</dd>
    <dt>Percentage point</dt><dd>One point on the 0 to 100 percent scale: 80% against 65% is a gap of 15 percentage points.</dd>
    <dt>High, medium and low confidence</dt><dd>How often chance alone would give a gap as big as the one a note reports; see "How sure a note is" under Notes and plan.</dd>
    <dt>T, body, wide</dt><dd>Where a serve landed: T near the middle line, body in the middle third of the service box (where the receiver usually stands), wide near the side line. When the computer did not see the bounce, it can guess T or wide from where the receiver stood to return the serve.</dd>
  </dl>
</section>
</details>

<footer class="sans">Generated {{ meta.generated_at or '' }}{% if meta.runtime_s %}; this run took {{ '%.0f'|format(meta.runtime_s) }} s (a run that reuses saved stages is much shorter than a full analysis){% endif %} · pipeline {{ meta.pipeline_version or '?' }}</footer>
</div>
<script>
(function(){
  var href = {{ (video_href or '')|tojson }};
  var vid = document.getElementById('vid'), pl = document.getElementById('player');
  window.closePlayer = function(){ vid.pause(); pl.style.display='none'; };
  vid.addEventListener('error', function(){ pl.style.display='none'; window.__videoFailed = true; });
  document.addEventListener('click', function(e){
    var a = e.target.closest && e.target.closest('a.ts');
    if (!a || !href || window.__videoFailed) return;
    e.preventDefault();
    if (!vid.getAttribute('src')) vid.src = href;
    pl.style.display = 'block';
    var t = parseFloat(a.getAttribute('data-t')) || 0;
    var go = function(){ vid.currentTime = t; vid.play().catch(function(){}); };
    if (vid.readyState >= 1) go(); else vid.addEventListener('loadedmetadata', go, {once:true});
    document.getElementById('vlabel').textContent = 'Point ' + a.closest('tr').cells[0].textContent.trim() + ', ' + a.textContent;
    pl.scrollIntoView({behavior:'smooth', block:'nearest'});
  });
  function applyFilters(){
    var p = document.getElementById('fPress').checked, l = document.getElementById('fLow').checked,
        s = document.getElementById('fSrv').value, any = p || l || s;
    document.querySelectorAll('#ptab tbody tr').forEach(function(tr){
      if (tr.dataset.gap) { tr.style.display = any ? 'none' : ''; return; }
      var ok = (!p || tr.dataset.press === '1') && (!l || tr.dataset.low === '1') && (!s || tr.dataset.srv === s);
      tr.style.display = ok ? '' : 'none';
    });
  }
  function openFor(id){ var s = id && document.getElementById(id); var d = s && s.closest('details'); if (d) { d.open = true; s.scrollIntoView(); } }
  document.addEventListener('click', function(e){ var a = e.target.closest && e.target.closest('a[href^="#"]'); if (a) openFor(a.getAttribute('href').slice(1)); });
  if (location.hash) openFor(location.hash.slice(1));
  ['fPress','fLow','fSrv'].forEach(function(id){ document.getElementById(id).addEventListener('change', applyFilters); });
})();
</script>
</body>
</html>